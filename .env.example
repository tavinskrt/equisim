# Equisim — variáveis de ambiente
#
# Copie este arquivo para `.env` na raiz do projeto e preencha os valores.
# O `.env` é ignorado pelo git e NÃO deve ser versionado.
#
#     cp .env.example .env
#
# Há dois leitores deste arquivo, e eles não veem as mesmas variáveis:
#
# - O **aplicativo** (Vite) lê só as variáveis com prefixo `VITE_`, e as
#   EMBARCA no bundle: tudo o que estiver numa `VITE_*` fica legível no
#   JavaScript servido pelo site. Nunca ponha segredo numa `VITE_*` de build
#   que vá ao ar.
# - As **ferramentas** de `tool/` (Node) leem `BRAPI_TOKEN` e `BRAPI_BASE_URL`,
#   sem prefixo, que o Vite ignora e nunca vão ao navegador.

# ---------------------------------------------------------------------------
# Aplicativo (Vite) — embarcado no bundle
# ---------------------------------------------------------------------------

# Produção: o proxy de custódia (functions/index.js). O token fica no servidor,
# e o cliente não carrega credencial alguma.
VITE_BRAPI_PROXY_URL=

# Só desenvolvimento local: o token da brapi direto no bundle. Deixe vazio em
# qualquer build que vá ao ar — use o proxy acima.
VITE_BRAPI_TOKEN=

# Raiz alternativa da brapi (raramente precisa ser alterada).
VITE_BRAPI_BASE_URL=

# `true` força o modo local, sem Firebase: carteiras e valuations ficam no
# navegador (IndexedDB).
VITE_EQUISIM_LOCAL=

# `true` liga o painel de logs (/logs) num build de produção; `false` o
# desliga no desenvolvimento.
VITE_EQUISIM_AUDIT=

# ---------------------------------------------------------------------------
# Ferramentas de medição (`npm run tool -- ...`) — só no Node
# ---------------------------------------------------------------------------

# Token da API brapi.dev — obtenha em https://brapi.dev/dashboard
BRAPI_TOKEN=

# URL base da API (raramente precisa ser alterada)
BRAPI_BASE_URL=https://brapi.dev/api

# ---------------------------------------------------------------------------
# QA autônomo com Google Gemini
# ---------------------------------------------------------------------------
# A GEMINI_API_KEY NÃO mora aqui: vai em `.env.qa`, que é ignorado pelo git e
# não é lido pelo Vite. Ver CLAUDE.md, seção "Credenciais".
