<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tema aplicado a janela do Android enquanto o processo inicia, com o modo escuro do sistema desligado -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <!-- Mostra uma tela de abertura na activity. Removida automaticamente
             quando o motor do Flutter desenha o primeiro quadro -->
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Tema aplicado a janela do Android assim que o processo comeca.
         Este tema define a cor da janela do Android enquanto a interface do
         Flutter inicializa, e por tras dela enquanto o aplicativo roda.

         Este tema so e usado a partir da V2 do embedding Android do Flutter. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
