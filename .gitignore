# Diversos
*.log
*.pyc
*.swp
.history
.DS_Store
.obsidian/
.idea/
.vscode/
coverage/

# Credenciais. O `.env` da raiz guarda o BRAPI_TOKEN das ferramentas e as
# variáveis `VITE_*` do aplicativo; os `.env.*` locais do Vite, idem. Só o
# modelo vai para o repositório.
.env
.env.*
*.env
!.env.example

# Credencial das ferramentas de QA (Gemini) — NUNCA versionar
.env.qa

# Dependências Node da raiz (aplicativo, ferramentas e QA)
/node_modules/

# Build da web (Vite), que o Firebase Hosting publica
/dist/

# Cloud Functions
functions/node_modules/
functions/.env*

# O harness do gabarito de paridade (test/parity/dart) só roda com o núcleo
# Dart restaurado de um commit antigo; o que ele compila e baixa não se versiona.
test/parity/dart/build/
test/parity/dart/.dart_tool/
test/parity/dart/pubspec.lock

# Cache do executor de validação (tool/lib/sqlite-cache.ts)
docs/validacao/*.sqlite

# Válvula de emergência dos hooks de QA (nunca versionar)
.qa-skip

# Fila de auditorias adiadas por cota (nunca versionar)
.qa-pending/

# Respostas cruas do conselheiro. Auditável localmente, não versionado:
# muda a cada execução e não é registro, é insumo para virar registro.
.conselho/

# Capturas de tela para a lente `tela` do conselheiro. Regeneradas a cada
# execução de `npm run ui:capturar` -- binário que muda sempre não pertence
# ao histórico. Marcos que valem arquivar vão para docs/telas/marcos/.
docs/telas/
!docs/telas/marcos/

# Base bruta da CVM: ~750 MB para 16 anos, reproduzível por
# `python tool/cvm_baixar.py`. Dado de terceiro, e não fonte deste projeto.
data/cvm/
data/cvm_exercicios.json
# As versões antigas dos documentos (item B8), por tool/cvm_versoes_baixar.py
# e `npm run tool -- cvm-ingest`.
data/cvm_versoes.json
# As coortes da réplica fora da amostra (item C7), antes de seladas: as seladas
# vão para docs/validacao/c7/ por `npm run tool -- c7-seal`.
data/c7/

# Taxas do Tesouro Direto (~15 MB), reproduzível por tool/tesouro_baixar.py.
data/tesouro/

# Série histórica de cotações da B3 (COTAHIST, ~80 MB por ano).
data/b3/

# Gabarito da cascata (D1), gerado por `npm run tool -- cascade-golden`, com a
# entrada congelada que ele repete: a cópia do cache da validação e o Ibovespa
# servido. Centenas de megabytes, e só valem contra o código em que foram
# gravados.
docs/validacao/gabarito_cascata.json
data/gabarito/
