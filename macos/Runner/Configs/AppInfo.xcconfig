// Configuracoes do aplicativo para o alvo Runner.
//
// No futuro isto pode ser substituido por algo gerado a partir dos metadados (por exemplo, o
// pubspec.yaml). Se nao for, os valores abaixo passariam a usar o nome do projeto quando isto
// virar um modelo do 'flutter create'.

// O nome do aplicativo. Por padrao, e tambem o titulo da janela do Flutter.
PRODUCT_NAME = Equisim

// O identificador de bundle do aplicativo
PRODUCT_BUNDLE_IDENTIFIER = com.example.equisim

// O copyright exibido nas informacoes do aplicativo
PRODUCT_COPYRIGHT = Copyright © 2026 com.example. Todos os direitos reservados.


