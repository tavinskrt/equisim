rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Estudos: as duas carteiras e a meta patrimonial.
    //
    // A atualização confere o dono dos dois lados, como a de `valuations`:
    // conferir só o documento antigo deixava o dono reescrever `userId` e
    // plantar um estudo, com o nome e os ativos que quisesse, na lista de
    // outra conta.
    match /portfolios/{studyId} {
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;

      allow update: if request.auth != null
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == request.auth.uid;

      allow read, delete: if request.auth != null
                          && resource.data.userId == request.auth.uid;
    }

    // Valuations confirmados na edição: premissas e resultado.
    // O documento é nomeado pelo identificador do registro, então a mesma
    // confirmação regravada sobrescreve em vez de duplicar — e sobrescrever
    // exige que o documento já seja de quem grava.
    match /valuations/{valuationId} {
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;

      allow update: if request.auth != null
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == request.auth.uid;

      allow read, delete: if request.auth != null
                          && resource.data.userId == request.auth.uid;
    }

    // Acompanhamentos da carteira na Meta: o plano congelado no
    // dia em que começou. Não se altera: regravar o mesmo documento (a nova
    // tentativa depois de uma falha de rede) passa, e qualquer mudança é
    // recusada. Mudou o plano, começa-se outro acompanhamento.
    match /trackings/{trackingId} {
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;

      allow update: if request.auth != null
                    && resource.data.userId == request.auth.uid
                    && request.resource.data == resource.data;

      allow read, delete: if request.auth != null
                          && resource.data.userId == request.auth.uid;
    }

    // As compras de cada acompanhamento. **Só se acrescentam**: a compra
    // gravada é a prova de que a decisão usou só o que se sabia no dia, e por
    // isso a alteração é recusada — como no plano, só a regravação idêntica
    // passa. A criação confere que o acompanhamento citado é de quem grava.
    match /trackingOrders/{orderId} {
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.trackingId is string
                    && getAfter(/databases/$(database)/documents/trackings/$(request.resource.data.trackingId)).data.userId == request.auth.uid;

      allow update: if request.auth != null
                    && resource.data.userId == request.auth.uid
                    && request.resource.data == resource.data;

      allow read, delete: if request.auth != null
                          && resource.data.userId == request.auth.uid;
    }

    // Coleção do escopo anterior (uma ação × um FII).
    //
    // Mantida somente leitura e exclusão: a aplicação não escreve mais aqui,
    // mas os dados históricos dos usuários continuam protegidos e acessíveis
    // até que eles decidam removê-los. Apagar a regra agora deixaria esses
    // documentos órfãos e sem controle de acesso.
    match /backtests/{backtestId} {
      allow read, delete: if request.auth != null
                          && resource.data.userId == request.auth.uid;
      allow create, update: if false;
    }

    // Preferências do usuário (tema).
    match /users/{userId} {
      allow read, write: if request.auth != null
                        && request.auth.uid == userId;
    }
  }
}
