{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["scripts/**/*.ts", "vite.config.ts", "vitest.config.ts"],
  // O gerador do changelog importa src/data, que segue a resolucao do aplicativo
  // (imports sem extensao); quem o confere e tool/tsconfig.json.
  "exclude": ["scripts/gerar-changelog.ts"]
}
